  <body>
    <div class="navbar">
      <div class="sp1">amazon.in</div>
      <div class="sp2">Account</div>
      <div class="sp3">My cart</div>
      <div class="sp4">Contact us</div>
      <div class="sp5">
        <form class="form">
          <input type="text" placeholder="    Search..." />
