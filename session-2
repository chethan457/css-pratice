---------------------------------------------------------- style --------------------------------------------------
* {
  margin: 0;
  padding: 0;
}

.navbar {
  display: flex;
  background-color: #0f1111;
  height: 40px;
  color: white;
  text-align: center;
  border: 5px solid white;
  border-radius: 2px;
}

.navbar div {
  display: flex;
  justify-content: center;
  align-items: center;
}

.sp1 {
  flex: 1;
  font-size: 25px;
}

.sp2 {
  flex: 1;
}

.sp3 {
  flex: 1;
}

.sp4 {
  flex: 1;
}

.sp5 {
  flex: 2;
}

.form {
  width: 100%;
  display: flex;
  gap: 20px;
  justify-content: flex-end;
}

.form input {
  width: 200px;
  border-radius: 5px;
}

.form button {
  margin: 0 10px 0 10px;
  background-color: #f08804;
  border-radius: 5px;
  width: 100px;
}
