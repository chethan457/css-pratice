--------------------------------------------------------- style -----------------------------------------------
* {
  padding: 0;
  margin: 0;
  color: white;
}

header {
  background-color: #0f1111;
  height: 60px;
  margin-bottom: 100px;
}
button {
  background-color: #f08804;

  width: 50px;
  color: black;
  border-radius: 5px;
}

a {
  margin-top: 15px;
  display: inline-block;
  text-decoration: none;
  margin-right: 200px;
}

.sp1 {
  font-size: 25px;
}

.sp5 {
  width: 250px;
  border-radius: 5px;
}

.box {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 200px;
}

.bx {
  width: 100px;
  height: 100px;
  border: 5px solid blue;
  display: flex;
  justify-content: center;
  align-items: center;
}

.bx1 {
  background-color: rgba(0, 0, 255, 0.5);
}

.bx2 {
  background-color: rgba(0, 0, 255, 0.75);
}
.bx3 {
  background-color: rgba(0, 0, 255, 1);
}

footer {
  background-color: #0f1111;
  height: 60px;

  display: flex;
  justify-content: center;
  align-items: center;
}

body {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.content {
  flex: 1;
}
